#!/usr/bin/env node
import { discoverCatalog } from "../src/catalog.js";
import { costReport } from "../src/cost.js";

const [filter, ...extra] = process.argv.slice(2);
if (extra.length || filter === "-h" || filter === "--help" || filter === "help") {
  console.log("usage: ai-cost [provider]\n\nModel prices grouped by provider, cheap first. Costs are USD per\nmillion tokens. Pass a provider to filter (case-insensitive).");
  process.exit(0);
}

const report = costReport(await discoverCatalog({}), filter);
if (!report) {
  console.error(filter ? `no provider "${filter}" in your catalog` : "catalog empty: run ai-model-configure models refresh");
  process.exit(1);
}
process.stdout.write(report);
